# Demo mode is deterministic, offline, and does not perform real model reasoning.
NILA_LLM_PROVIDER=demo
NILA_PORT=8765

# For hosted reasoning: change provider to openai and select an available model.
# NILA_LLM_PROVIDER=openai
# NILA_OPENAI_MODEL=your-model-id
# Prefer `uv run nila auth set-openai-key` over storing credentials here.
# NILA_OPENAI_API_KEY=

# Optional alternative to the Windows credential store (minimum 32 characters).
# NILA_API_TOKEN=

# Defaults to %LOCALAPPDATA%\NILA-AI on Windows.
# NILA_DATA_DIR=C:\Users\your-name\AppData\Local\NILA-AI
NILA_MAX_STEPS=5
NILA_MAX_CONTEXT_CHARS=16000
NILA_MAX_OUTPUT_TOKENS=1200
NILA_LLM_TIMEOUT_SECONDS=30
NILA_TASK_TIMEOUT_SECONDS=60
NILA_APPROVAL_TTL_SECONDS=300
